{% liquid
  assign header_asset = ''
  case product.handle
    when 'hi-creatine'
      assign header_asset = 'foulplay-header-hi-creatine.png'
    when 'purest-creatine-sachets'
      assign header_asset = 'foulplay-header-purest-creatine.png'
  endcase
  assign current_variant = product.selected_or_first_available_variant
  assign image_alt = product.featured_image.alt | default: product.title
  assign summary = summary | default: product.description | strip_html | truncate: 120
%}
<product-form class="fp-header__product-form" data-header-product-form="{{ product.handle }}" data-header-product-slot="{{ slot }}" hidden>
  {% form 'product', product, class: 'fp-header__hero-product' %}
    <span class="fp-header__frame" aria-hidden="true"></span>
    <input type="hidden" name="id" value="{{ current_variant.id }}">
    <div class="fp-header__hero-identity">
      {% if header_asset != blank %}
        <span class="fp-header__hero-thumbnail fp-header__hero-thumbnail--{{ product.handle }}"><img src="{{ header_asset | asset_url }}" alt="{{ image_alt | escape }}" width="80" height="80" loading="lazy"></span>
      {% elsif product.featured_image != blank %}
        {{ product.featured_image | image_url: width: 160 | image_tag: width: 80, height: 80, loading: 'lazy', alt: image_alt }}
      {% endif %}
      <div><p class="fp-header__eyebrow">{{ product.title | escape }}</p><p class="fp-header__muted">{{ subtitle | escape }}</p></div>
    </div>
    <div class="fp-header__hero-details">
      <div>{% if launch %}<p>{{ launch_heading | escape }}</p><p class="fp-header__muted">{{ summary | escape }}</p>{% else %}<p>{{ summary | escape }}</p><p class="fp-header__muted">From {{ product.price_min | money }}</p>{% endif %}</div>
      <button class="fp-header__hero-add" type="submit" name="add"{% if launch %} hidden{% endif %}{% unless current_variant.available %} disabled aria-disabled="true"{% endunless %}>
        <span>{% if current_variant.available %}Add to Cart{% else %}Sold Out{% endif %}</span>
        <span class="hidden" data-uc-loading-overlay-spinner aria-hidden="true"></span>
      </button>
      <div data-uc-product-form-error-message-wrapper role="alert" hidden><span data-uc-product-form-error-message></span></div>
    </div>
    <a class="fp-header__button fp-header__hero-view" href="{{ product.url }}">View Product</a>
  {% endform %}
</product-form>

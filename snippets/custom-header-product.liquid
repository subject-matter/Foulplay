{% if product != blank %}
  <a class="fp-header__product" href="{{ product.url }}">
    <span class="fp-header__product-image">
      {% if product.featured_image != blank %}
        {% assign image_alt = product.featured_image.alt | default: product.title %}
        {{ product.featured_image | image_url: width: 192 | image_tag: loading: 'lazy', widths: '64, 128, 192', alt: image_alt }}
      {% endif %}
    </span>
    <span class="fp-header__product-copy">
      <span class="fp-header__eyebrow">{{ product.title | escape }}</span>
      {% if description != blank %}<span class="fp-header__muted">{{ description | escape }}</span>{% endif %}
    </span>
  </a>
{% endif %}

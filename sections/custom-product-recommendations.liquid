{% comment %}
	=== FUNCTIONALITY ===

	- Renders related products as the Foulplay product grid.
	- Uses Shopify product recommendations, loaded on scroll.


	Section Author: rishi@subjectmatter.studio
{% endcomment %}

{% # MARK:- Related products from Figma node 1287:42457 %}
{% render 'vite', vite: 'js-dir-product.ts' %}

{% liquid
	assign limit = section.settings.products_to_show | default: 4
%}

<product-recommendations
	class="foulplay-related"
	data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ limit }}&intent=related"
	data-node-id="1287:42457"
>
	{% if recommendations.performed and recommendations.products_count > 0 %}
		<div class="foulplay-related__header">
			<h2>{{ section.settings.heading | escape }}</h2>
		</div>
		<div class="foulplay-related__grid">
			{% for recommendation in recommendations.products %}
				{% render 'custom-foulplay-card-product',
					product: recommendation,
					section_id: section.id,
					sizes: '(min-width: 1000px) 336px, (min-width: 500px) 50vw, 84vw'
				%}
			{% endfor %}
		</div>
	{% endif %}
</product-recommendations>

{% schema %}
	{
		"name": "Related products",
		"tag": "section",
		"class": "section section--related",
		"settings": [
			{ "type": "text", "id": "heading", "label": "Heading", "default": "Related Products" },
			{
				"type": "range",
				"id": "products_to_show",
				"min": 2,
				"max": 8,
				"step": 1,
				"label": "Products to show",
				"default": 4
			}
		],
		"presets": [{ "name": "Related products" }]
	}
{% endschema %}

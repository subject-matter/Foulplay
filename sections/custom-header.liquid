{% liquid
	assign menu_collections = section.blocks | where: 'type', 'collection'
	assign first_collection_id = ''
	for block in menu_collections
		if block.settings.collection != blank
			assign first_collection_id = block.id
			assign featured_collection = block.settings.collection
			break
		endif
	endfor
%}

<foulplay-header
	class="fp-header{% if request.page_type == 'index' %} fp-header--home{% endif %}"
	data-section-id="{{ section.id }}"
	data-offer-duration="{{ section.settings.message_duration | default: 5 }}"
>
	<header class="fp-header__shell" data-header-shell>
		<div class="fp-header__grid" data-header-grid>
			<span class="fp-header__surface" aria-hidden="true"></span>
			<a
				class="fp-header__cell fp-header__brand"
				href="{{ routes.root_url }}"
				aria-label="{{ shop.name }} home"
			>
				<span class="fp-header__frame" aria-hidden="true"></span>
				<img
					class="fp-header__wordmark"
					src="{{ 'foulplay-wordmark.svg' | asset_url }}"
					width="136"
					height="24"
					alt="{{ shop.name }}"
				>
				<span class="fp-header__tagline">
					{{- section.settings.tagline | newline_to_br -}}
				</span>
			</a>

			<div class="fp-header__menus">
				<nav class="fp-header__primary" aria-label="Primary navigation">
					<button
						class="fp-header__cell fp-header__nav-cell"
						type="button"
						data-shop-trigger
						aria-expanded="false"
						aria-controls="FpShopMenu-{{ section.id }}"
					>
						<span
							class="fp-header__frame"
							aria-hidden="true"
						></span>
						<span class="fp-header__nav-label">Shop</span>
					</button>

					<a
						class="fp-header__cell fp-header__nav-cell"
						href="{{ section.settings.science_url | default: routes.root_url }}"
					>
						<span
							class="fp-header__frame"
							aria-hidden="true"
						></span>
						<span class="fp-header__nav-label">Science</span>
					</a>

					<div class="fp-header__cell fp-header__nav-cell fp-header__nav-cell--actions">
						<span
							class="fp-header__frame"
							aria-hidden="true"
						></span>
						<button
							class="fp-header__nav-label fp-header__plain-button"
							type="button"
							data-drawer-trigger="journal"
							aria-expanded="false"
							aria-controls="FpJournalDrawer-{{ section.id }}"
						>
							Journal
						</button>
						<span class="fp-header__actions">
							<a
								class="fp-header__icon-link"
								href="{{ routes.account_url }}"
								aria-label="Account"
							>
								<svg viewBox="0 0 16 16" aria-hidden="true">
									<circle cx="8" cy="5" r="2.25"></circle>
									<path d="M3.5 13.5c.25-2.65 1.75-4 4.5-4s4.25 1.35 4.5 4h-9Z"></path>
								</svg>
							</a>
							<button
								class="fp-header__plain-button fp-header__cart-count"
								type="button"
								data-drawer-trigger="cart"
								data-header-cart-trigger
								aria-expanded="false"
								aria-controls="FpCartDrawer-{{ section.id }}"
								aria-label="Open cart, {{ cart.item_count }} items"
							>
								{{ cart.item_count }}
							</button>
						</span>
					</div>
				</nav>

				<div class="fp-header__expanded-row" data-expanded-row>
					<div class="fp-header__cell fp-header__offer">
						<span
							class="fp-header__frame"
							aria-hidden="true"
						></span>
						<div class="fp-header__offer-track" data-offer-track>
							{% for block in section.blocks %}
								{% if block.type == 'message' %}
									<p
										class="fp-header__offer-message{% if forloop.first %} is-active{% endif %}"
									data-offer-message
									aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
										{{ block.shopify_attributes }}
									>
										{{
											block.settings.text
											| newline_to_br
										}}
									</p>
								{% endif %}
							{% endfor %}
						</div>
						{% assign message_blocks = section.blocks
							| where: 'type', 'message'
						%}
						{% if message_blocks.size > 1 %}
							<div
								class="fp-header__pagination"
								aria-label="Select promotion"
							>
								{% for block in message_blocks limit: 3 %}
									<button
										class="fp-header__dot{% if forloop.first %} is-active{% endif %}"
										type="button"
										data-offer-dot="{{ forloop.index0 }}"
										aria-label="Show promotion {{ forloop.index }}"
										{% if forloop.first %}
											aria-current="true"
										{% endif %}
									></button>
								{% endfor %}
							</div>
						{% endif %}
					</div>

					<div class="fp-header__cell fp-header__statement">
						<span
							class="fp-header__frame"
							aria-hidden="true"
						></span>
						<p>{{ section.settings.statement | strip_html | strip | truncate: 116, '' | escape }}</p>
					</div>

					<div class="fp-header__cell fp-header__cta-cell">
						<span
							class="fp-header__frame"
							aria-hidden="true"
						></span>
						<a
							class="fp-header__button"
							href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}"
						>
							{{ section.settings.cta_label }}
						</a>
					</div>
				</div>
			</div>

			<div class="fp-header__product-row" data-header-product-row></div>
		</div>

		<div
			class="fp-header__shop"
			id="FpShopMenu-{{ section.id }}"
			data-shop-menu
			aria-hidden="true"
		>
			<div class="fp-header__shop-tabs" role="tablist" aria-label="Shop categories">
				<span class="fp-header__frame" aria-hidden="true"></span>
				{% for block in menu_collections %}
					{% assign menu_collection = block.settings.collection %}
					{% if menu_collection != blank %}
						<button type="button" role="tab" id="ShopTab-{{ section.id }}-{{ block.id }}"
							class="fp-header__shop-tab{% if block.id == first_collection_id %} is-active{% endif %}"
							data-shop-tab="{{ block.id }}" aria-controls="ShopPanel-{{ section.id }}-{{ block.id }}"
							aria-selected="{% if block.id == first_collection_id %}true{% else %}false{% endif %}"
							tabindex="{% if block.id == first_collection_id %}0{% else %}-1{% endif %}"
							{{ block.shopify_attributes }}>
							{{ menu_collection.title | escape }}<span class="fp-header__category-count"><span>{{ menu_collection.products.size | at_most: 3 }}</span></span>
						</button>
					{% elsif request.design_mode %}
						<span {{ block.shopify_attributes }}>Select a collection</span>
					{% endif %}
				{% endfor %}
				<span class="fp-header__category-line" data-shop-category-line aria-hidden="true"></span>
			</div>

			<div class="fp-header__shop-content">
				<span class="fp-header__frame" aria-hidden="true"></span>
				{% for block in menu_collections %}
					{% assign menu_collection = block.settings.collection %}
					{% if menu_collection != blank %}
						<div class="fp-header__featured-products" role="tabpanel" tabindex="0"
							id="ShopPanel-{{ section.id }}-{{ block.id }}" data-shop-panel="{{ block.id }}"
							aria-labelledby="ShopTab-{{ section.id }}-{{ block.id }}"{% unless block.id == first_collection_id %} hidden{% endunless %}>
							{% for menu_product in menu_collection.products limit: 3 %}
								{% assign product_description = menu_product.description | strip_html | strip | truncate: 120 %}
								{% render 'custom-header-product', product: menu_product, description: product_description %}
							{% else %}
								<p class="fp-header__collection-empty">No products in this collection yet.</p>
							{% endfor %}
						</div>
					{% endif %}
				{% endfor %}
				{% if first_collection_id == blank %}
					<div class="fp-header__featured-products">
						<a class="fp-header__collection-empty" href="{{ routes.all_products_collection_url }}">Explore all products</a>
					</div>
				{% endif %}

				<div class="fp-header__shop-promo">
					<div>
						<p class="fp-header__eyebrow">Save with Bundles</p>
						<p class="fp-header__muted">
							Choose a bundle and save 15% compared to buying
							items individually. Simply select your bundle and
							the discount is applied automatically.
						</p>
					</div>
					<a
						class="fp-header__button fp-header__button--dark"
						href="{{ section.settings.bundles_url | default: routes.all_products_collection_url }}"
						>Shop Bundles</a
					>
				</div>

				<div class="fp-header__shop-promo">
					<div>
						<p class="fp-header__eyebrow">
							Save with Subscriptions
						</p>
						<p class="fp-header__muted">
							Stay consistent and save effortlessly with
							subscriptions.
						</p>
						<p class="fp-header__included">Included :</p>
						<ul class="fp-header__muted">
							<li>15% Off Every Order</li>
							<li>Bonus Gifts Included</li>
							<li>Free delivery (save $3.99)</li>
							<li>Pause or Cancel Anytime</li>
						</ul>
					</div>
					<a
						class="fp-header__button fp-header__button--dark"
						href="{{ section.settings.subscription_url | default: routes.all_products_collection_url }}"
						>Create Subscription</a
					>
				</div>
			</div>
		</div>
	</header>

	<div class="fp-header__backdrop" data-drawer-backdrop hidden></div>

	<aside
		class="fp-header__drawer fp-header__drawer--journal"
		id="FpJournalDrawer-{{ section.id }}"
		data-drawer="journal"
		aria-hidden="true"
		aria-label="Journal"
	>
		<div class="fp-header__drawer-nav">
			<nav aria-label="Journal categories">
				<a
					class="is-active"
					href="{{ section.settings.journal_url | default: routes.root_url }}"
					>All</a
				>
				<a href="{{ section.settings.journal_url | default: routes.root_url }}"
					>Discover</a
				>
				<a href="{{ section.settings.journal_url | default: routes.root_url }}"
					>Events</a
				>
				<a href="{{ section.settings.journal_url | default: routes.root_url }}"
					>Foulplay Presents</a
				>
			</nav>
			<button
				class="fp-header__drawer-close"
				type="button"
				data-drawer-close
				aria-label="Close journal"
			>
				<svg viewBox="0 0 16 16" aria-hidden="true">
					<path d="m3 3 10 10M13 3 3 13"></path>
				</svg>
			</button>
		</div>
		<div class="fp-header__journal-grid">
			{% assign journal_blog = section.settings.journal_blog %}
			{% if journal_blog != blank and journal_blog.articles_count > 0 %}
				{% for article in journal_blog.articles limit: 8 %}
					<a class="fp-header__article" href="{{ article.url }}">
						{% if article.image %}
							{{
								article.image
								| image_url: width: 920
								| image_tag:
									loading: 'lazy',
									widths: '360, 540, 720, 920',
									alt: article.image.alt
								| default: article.title
							}}
						{% endif %}
						<span class="fp-header__article-title">
							{{- article.title -}}
						</span>
						<span class="fp-header__muted">
							{{-
								article.excerpt_or_content
								| strip_html
								| truncatewords: 24
							-}}
						</span>
					</a>
				{% endfor %}
			{% else %}
				{% render 'custom-header-journal-placeholder' %}
			{% endif %}
		</div>
	</aside>

	<aside
		class="fp-header__drawer fp-header__drawer--cart"
		id="FpCartDrawer-{{ section.id }}"
		data-drawer="cart"
		aria-hidden="true"
		aria-label="Cart"
	>
		<div class="fp-header__cart-heading">
			<span data-header-cart-heading>Cart ({{ cart.item_count }})</span>
			<button
				class="fp-header__plain-button"
				type="button"
				data-drawer-close
			>
				Close
			</button>
		</div>
		<div class="fp-header__cart-body" data-header-cart-body>
			{% if cart.item_count == 0 %}
				<p>Your cart is currently empty</p>
			{% else %}
				{% for item in cart.items %}
					<a class="fp-header__cart-item" href="{{ item.url }}">
						{% if item.image %}
							{{
								item.image
								| image_url: width: 160
								| image_tag:
									loading: 'lazy',
									width: 80,
									height: 80,
									alt: item.image.alt
								| default: item.product.title
							}}
						{% endif %}
						<span>
							{{- item.product.title -}}
							<br>
							{{ item.final_line_price | money -}}
						</span>
					</a>
				{% endfor %}
			{% endif %}
		</div>
		{% if featured_collection.products.size > 0 %}
			<div class="fp-header__cart-upsells">
				<p>{{ featured_collection.title | escape }}</p>
				{% for featured_product in featured_collection.products limit: 2 %}
					{% render 'custom-header-product', product: featured_product %}
				{% endfor %}
			</div>
		{% endif %}
	</aside>
</foulplay-header>

{% schema %}
{
	"name": "Header",
	"tag": "section",
	"class": "section-header",
	"limit": 1,
	"settings": [
		{
			"type": "range",
			"id": "message_duration",
			"label": "Message cycle duration",
			"min": 0,
			"max": 15,
			"step": 1,
			"unit": "s",
			"default": 5,
			"info": "Set to 0 to turn off automatic message changes."
		},
		{
			"type": "textarea",
			"id": "tagline",
			"label": "Tagline",
			"default": "A new vision for\nperformance nutrition"
		},
		{
			"type": "textarea",
			"id": "statement",
			"label": "Statement",
			"info": "Maximum 116 characters, including spaces and punctuation. The storefront displays only the first 116 characters.",
			"default": "Performance nutrition should work for your lifestyle, not complicate it. That’s exactly where FOULPLAY stands apart."
		},
		{
			"type": "text",
			"id": "cta_label",
			"label": "Call to action label",
			"default": "Explore All Products"
		},
		{
			"type": "url",
			"id": "cta_url",
			"label": "Call to action link"
		},
		{
			"type": "url",
			"id": "science_url",
			"label": "Science link"
		},
		{
			"type": "url",
			"id": "journal_url",
			"label": "Journal link"
		},
		{
			"type": "url",
			"id": "bundles_url",
			"label": "Bundles link"
		},
		{
			"type": "url",
			"id": "subscription_url",
			"label": "Subscription link"
		},
		{
			"type": "blog",
			"id": "journal_blog",
			"label": "Journal blog"
		}
	],
	"blocks": [
		{
			"type": "message",
			"name": "Promotion",
			"limit": 3,
			"settings": [
				{
					"type": "textarea",
					"id": "text",
					"label": "Text",
					"default": "Get 15% off your first order\n“NEW16”"
				}
			]
		},
		{
			"type": "collection",
			"name": "Collection",
			"settings": [
				{
					"type": "collection",
					"id": "collection",
					"label": "Collection",
					"info": "Uses the collection title and first 3 products, in collection order. The first collection also supplies cart recommendations."
				}
			]
		}
	],
	"presets": [
		{
			"name": "Header",
			"blocks": [
				{
					"type": "message"
				},
				{
					"type": "message",
					"settings": {
						"text": "Free delivery on subscriptions\nSUBSCRIBE"
					}
				},
				{
					"type": "message",
					"settings": {
						"text": "Build a complete routine\nSHOP BUNDLES"
					}
				},
				{
					"type": "collection"
				}
			]
		}
	]
}
{% endschema %}

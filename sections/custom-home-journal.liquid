{% comment %}
	=== FUNCTIONALITY ===

	- Shows the homepage journal carousel.
	- Opens the journal drawer from each category control.


	Section Author: rishi@subject-matter.studio
{% endcomment %}

<foulplay-journal-carousel class="foulplay-journal-section" data-node-id="1287:41720">
	<header class="foulplay-journal-section__header">
		<h2>{{ section.settings.heading | escape }}</h2>
		<div class="foulplay-journal-section__header-content">
			<nav aria-label="{{ section.settings.filter_label | escape }}">
				<button type="button" data-journal-drawer>All</button>
				<button type="button" data-journal-drawer>Dossier</button>
				<button type="button" data-journal-drawer>Events</button>
				<button type="button" data-journal-drawer>Special Projects</button>
			</nav>
			<div class="foulplay-journal-section__controls">
				<button type="button" data-journal-previous aria-label="Previous articles">
					<span aria-hidden="true">‹</span>
				</button>
				<button type="button" data-journal-next aria-label="Next articles">
					<span aria-hidden="true">›</span>
				</button>
			</div>
		</div>
	</header>
	<div class="foulplay-journal-section__track" data-journal-track>
		{% content_for 'blocks' %}
	</div>
</foulplay-journal-carousel>

{% schema %}
	{
		"name": "Journal",
		"tag": "section",
		"class": "section section--home-journal",
		"disabled_on": { "groups": ["header", "footer"] },
		"blocks": [{ "type": "foulplay-journal" }],
		"max_blocks": 12,
		"settings": [
			{
				"type": "text",
				"id": "heading",
				"label": "Heading",
				"default": "Journal"
			},
			{
				"type": "text",
				"id": "filter_label",
				"label": "Filter label",
				"default": "Journal categories"
			}
		],
		"presets": [
			{
				"name": "Journal",
				"blocks": [
					{ "type": "foulplay-journal" },
					{ "type": "foulplay-journal" },
					{ "type": "foulplay-journal" }
				]
			}
		]
	}
{% endschema %}

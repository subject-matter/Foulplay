{% liquid
  assign desktop_image = section.settings.desktop_image
  assign mobile_image = section.settings.mobile_image
%}

{% # MARK:- Homepage opening image from Figma node 1287:60313 %}
<section class="home-opening" data-node-id="1287:60313">
  <picture class="home-opening__media" data-no-fade>
    {% if mobile_image != blank %}
      <source
        media="(max-width: 749px)"
        srcset="
          {{ mobile_image | image_url: width: 750 }} 750w,
          {{ mobile_image | image_url: width: 1100 }} 1100w
        "
        sizes="100vw"
      >
    {% endif %}

    {% if desktop_image != blank %}
      {{ desktop_image
        | image_url: width: 2880
        | image_tag:
          widths: '960, 1440, 1920, 2400, 2880',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: ''
      }}
    {% else %}
      <img
        src="{{ 'foulplay-home-hero-athlete.png' | asset_url }}"
        width="720"
        height="1280"
        alt=""
        loading="eager"
        fetchpriority="high"
      >
    {% endif %}
  </picture>
</section>

{% schema %}
{
  "name": "Opening image",
  "tag": "section",
  "class": "section section--home-opening",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Uses the desktop image when empty."
    }
  ],
  "presets": [
    {
      "name": "Opening image"
    }
  ]
}
{% endschema %}

{% comment %}
	=== FUNCTIONALITY ===

	- Renders the reviews module with a summary, review cards, and ambassadors.
	- Ambassadors reuse the roster switcher for the portrait and quote.


	Section Author: rishi@subjectmatter.studio
{% endcomment %}

{% # MARK:- Reviews module from Figma node 1287:42333 %}
{% liquid
	assign reviews = section.blocks | where: 'type', 'review'
	assign ambassadors = section.blocks | where: 'type', 'ambassador'
	assign avg_rating = section.settings.average_rating
	if avg_rating == blank
		assign avg_rating = product.metafields.reviews.rating.value
	endif
	assign total_reviews = section.settings.total_reviews
	if total_reviews == blank
		assign total_reviews = product.metafields.reviews.rating_count.value
	endif
	assign write_review_label = section.settings.write_review_label | default: 'Write a Review'
%}

<section class="foulplay-reviews" data-node-id="1287:42333">
	<div class="foulplay-reviews__summary">
		<div class="foulplay-reviews__summary-head">
			<h2 class="foulplay-reviews__eyebrow">
				{{ section.settings.heading | default: 'Reviews' }}
			</h2>
			<p class="foulplay-reviews__sort">
				{{ section.settings.sort_label | default: 'Sort by' }}
				<span class="foulplay-pill foulplay-pill--outline">
					{{- section.settings.sort_value | default: 'Featured' -}}
				</span>
			</p>
		</div>
		<div class="foulplay-reviews__stats">
			{% if total_reviews != blank %}
				<p class="foulplay-reviews__total">
					<strong>{{ total_reviews }}</strong>
					<span>{{ section.settings.total_label | default: 'Total Reviews' }}</span>
				</p>
			{% endif %}
			{% if avg_rating != blank %}
				<p class="foulplay-reviews__average">
					<strong>{{ avg_rating | round: 1 }}</strong>
					<span class="foulplay-reviews__stars" aria-hidden="true">
						{% assign rounded = avg_rating | round %}
						{% for i in (1..5) %}
							{% if i <= rounded %}★{% else %}☆{% endif %}
						{% endfor %}
					</span>
					<span>{{ section.settings.average_label | default: 'Average rating' }}</span>
				</p>
			{% endif %}
			{% if section.settings.write_review_url != blank %}
				{% render 'custom-foulplay-button',
					label: write_review_label,
					url: section.settings.write_review_url,
					style: 'secondary',
					class: 'foulplay-button--pill'
				%}
			{% endif %}
		</div>
	</div>

	<div class="foulplay-reviews__list">
		{% for block in reviews %}
			<article class="foulplay-review" {{ block.shopify_attributes }}>
				<p class="foulplay-review__stars" aria-hidden="true">
					{% assign rating = block.settings.rating | round %}
					{% for i in (1..5) %}
						{% if i <= rating %}★{% else %}☆{% endif %}
					{% endfor %}
				</p>
				<span class="visually-hidden">
					Rated {{ block.settings.rating }} out of 5
				</span>
				{% if block.settings.title != blank %}
					<h3 class="foulplay-review__title">{{ block.settings.title | escape }}</h3>
				{% endif %}
				{% if block.settings.body != blank %}
					<div class="foulplay-review__body">{{ block.settings.body }}</div>
				{% endif %}
				{% if block.settings.image != blank %}
					<div class="foulplay-review__media">
						{{
							block.settings.image
							| image_url: width: 260
							| image_tag:
								widths: '130, 260',
								sizes: '130px',
								loading: 'lazy',
								alt: ''
						}}
					</div>
				{% endif %}
				<footer class="foulplay-review__meta">
					<p class="foulplay-review__author">
						{{ block.settings.author | escape }}
						{% if block.settings.verified %}
							<span class="foulplay-review__verified">
								{{ section.settings.verified_label | default: 'Verified Buyer' }}
							</span>
						{% endif %}
					</p>
					{% if block.settings.date != blank %}
						<p class="foulplay-review__date">{{ block.settings.date | escape }}</p>
					{% endif %}
				</footer>
			</article>
		{% endfor %}
	</div>

	{% if ambassadors.size > 0 %}
		<foulplay-roster class="foulplay-ambassadors">
			<h2 class="foulplay-reviews__eyebrow">
				{{ section.settings.ambassadors_heading | default: 'Ambassadors' }}
			</h2>
			<div class="foulplay-ambassadors__inner">
				<ul class="foulplay-ambassadors__names">
					{% for block in ambassadors %}
						<li {{ block.shopify_attributes }}>{{ block.settings.name | escape }}</li>
					{% endfor %}
				</ul>
				<div class="foulplay-ambassadors__stage">
					<div class="foulplay-roster-section__hero">
						{% assign first_ambassador = ambassadors | first %}
						{% if first_ambassador.settings.portrait != blank %}
							<img
								src="{{ first_ambassador.settings.portrait | image_url: width: 900 }}"
								width="453"
								height="500"
								loading="lazy"
								alt="{{ first_ambassador.settings.name | escape }}"
							>
						{% endif %}
						<div class="foulplay-ambassadors__controls">
							<button type="button" data-roster-previous aria-label="Previous ambassador">‹</button>
							<button type="button" data-roster-next aria-label="Next ambassador">›</button>
						</div>
					</div>
					<div data-roster-profiles>
						{% for block in ambassadors %}
							<div
								class="shopify-block foulplay-ambassadors__profile"
								{% unless forloop.first %}
									hidden
								{% endunless %}
							>
								<div
									data-roster-card
									data-roster-hero="{{ block.settings.portrait | image_url: width: 900 }}"
								>
									{% if block.settings.quote != blank %}
										<blockquote class="foulplay-ambassadors__quote">
											{{ block.settings.quote }}
										</blockquote>
									{% endif %}
									<p class="foulplay-ambassadors__name">{{ block.settings.name | escape }}</p>
									{% if block.settings.role != blank %}
										<p class="foulplay-ambassadors__role">{{ block.settings.role | escape }}</p>
									{% endif %}
								</div>
							</div>
						{% endfor %}
					</div>
				</div>
			</div>
		</foulplay-roster>
	{% endif %}
</section>

{% schema %}
	{
		"name": "Product reviews",
		"tag": "section",
		"class": "section section--reviews",
		"blocks": [
			{
				"type": "review",
				"name": "Review",
				"settings": [
					{ "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Rating", "default": 5 },
					{ "type": "text", "id": "title", "label": "Title" },
					{ "type": "richtext", "id": "body", "label": "Body" },
					{ "type": "image_picker", "id": "image", "label": "Image" },
					{ "type": "text", "id": "author", "label": "Author", "default": "Jane Appleseed" },
					{ "type": "checkbox", "id": "verified", "label": "Verified buyer", "default": true },
					{ "type": "text", "id": "date", "label": "Date", "default": "2 Months ago" }
				]
			},
			{
				"type": "ambassador",
				"name": "Ambassador",
				"settings": [
					{ "type": "text", "id": "name", "label": "Name", "default": "Dr. Dean Ho" },
					{ "type": "text", "id": "role", "label": "Role" },
					{ "type": "image_picker", "id": "portrait", "label": "Portrait" },
					{ "type": "richtext", "id": "quote", "label": "Quote" }
				]
			}
		],
		"settings": [
			{ "type": "text", "id": "heading", "label": "Heading", "default": "Reviews" },
			{ "type": "text", "id": "sort_label", "label": "Sort label", "default": "Sort by" },
			{ "type": "text", "id": "sort_value", "label": "Sort value", "default": "Featured" },
			{ "type": "text", "id": "total_reviews", "label": "Total reviews override" },
			{ "type": "text", "id": "total_label", "label": "Total label", "default": "Total Reviews" },
			{ "type": "text", "id": "average_rating", "label": "Average rating override" },
			{ "type": "text", "id": "average_label", "label": "Average label", "default": "Average rating" },
			{ "type": "text", "id": "verified_label", "label": "Verified label", "default": "Verified Buyer" },
			{ "type": "text", "id": "write_review_label", "label": "Write review label", "default": "Write a Review" },
			{ "type": "url", "id": "write_review_url", "label": "Write review link" },
			{ "type": "text", "id": "ambassadors_heading", "label": "Ambassadors heading", "default": "Ambassadors" }
		],
		"presets": [{ "name": "Product reviews" }]
	}
{% endschema %}

{% comment %}
	=== FUNCTIONALITY ===

	- Renders the shared footer from the Figma homepage.
	- Includes newsletter signup, policy links, localization, and social links.
	- Uses merchant-selected artwork when it is available.


	Section Author: rishi@subject-matter.studio
{% endcomment %}

{% liquid
	assign terms_url = section.settings.terms_url | default: shop.terms_of_service.url
	assign privacy_url = section.settings.privacy_url | default: shop.privacy_policy.url
	assign instagram_url = section.settings.instagram_url | default: settings.social_instagram_link
	assign tiktok_url = section.settings.tiktok_url | default: settings.social_tiktok_link
%}

{% # MARK:- Shared footer from Figma node 3223:34087 %}
<footer class="foulplay-footer" data-node-id="3223:34087">
	<div class="foulplay-footer__left">
		<div class="foulplay-footer__newsletter">
			<div>
				<h2>{{ section.settings.newsletter_heading | escape }}</h2>
				<p>{{ section.settings.newsletter_body | escape }}</p>
			</div>

			{% form 'customer',
				id: 'FoulplayFooterNewsletter',
				class: 'foulplay-footer__form'
			%}
				<input type="hidden" name="contact[tags]" value="newsletter">
				<div class="foulplay-footer__fields">
					<label class="visually-hidden" for="FoulplayFooterEmail">
						{{- section.settings.email_label | escape -}}
					</label>
					<input
						id="FoulplayFooterEmail"
						type="email"
						name="contact[email]"
						value="{{ form.email | escape }}"
						placeholder="{{ section.settings.email_label | escape }}"
						autocomplete="email"
						aria-describedby="FoulplayFooterConsent{% if form.errors contains 'email' %} FoulplayFooterEmailError{% endif %}"
						{% if form.errors contains 'email' %}
							aria-invalid="true"
						{% endif %}
						required
					>
					<label class="visually-hidden" for="FoulplayFooterPhone">
						{{- section.settings.phone_label | escape -}}
					</label>
					<input
						id="FoulplayFooterPhone"
						type="tel"
						name="contact[phone]"
						placeholder="{{ section.settings.phone_label | escape }}"
						autocomplete="tel"
					>
				</div>

				<p id="FoulplayFooterConsent" class="foulplay-footer__terms">
					{{ section.settings.consent_prefix | escape }}
					{% if terms_url != blank %}
						<a href="{{ terms_url }}">
							{{- section.settings.terms_label | escape -}}
						</a>
					{% else %}
						{{ section.settings.terms_label | escape }}
					{% endif %}
					{{ section.settings.consent_joiner | escape }}
					{%- if privacy_url != blank -%}
						<a href="{{ privacy_url }}">
							{{- section.settings.privacy_label | escape -}}
						</a>
					{%- else -%}
						{{ section.settings.privacy_label | escape }}
					{%- endif -%}
					.
				</p>

				{% if form.posted_successfully? %}
					<p class="foulplay-footer__message" role="status">
						{{- section.settings.success_message | escape -}}
					</p>
				{% elsif form.errors %}
					<div
						id="FoulplayFooterEmailError"
						class="foulplay-footer__message"
						role="alert"
					>
						{{ form.errors | default_errors }}
					</div>
				{% endif %}

				{% render 'custom-foulplay-button',
					label: section.settings.submit_label,
					style: 'pill',
					type: 'submit'
				%}
			{% endform %}
		</div>

		<div class="foulplay-footer__footnotes">
			<img
				src="{{ 'foulplay-wordmark.svg' | asset_url }}"
				width="136"
				height="24"
				alt="FOULPLAY"
				loading="lazy"
			>
			<p>{{ section.settings.disclaimer | escape }}</p>

			{% if localization.available_countries.size > 1 %}
				<details class="foulplay-footer__localization">
					<summary>
						{{ localization.country.name }} (
						{{- localization.country.currency.iso_code -}}
						)
					</summary>
					<ul role="list">
						{% for country in localization.available_countries %}
							<li>
								{% form 'localization' %}
									<input
										type="hidden"
										name="country_code"
										value="{{ country.iso_code }}"
									>
									<button
										type="submit"
										{% if country.iso_code
												== localization.country.iso_code
										%}
											aria-current="true"
										{% endif %}
									>
										{{ country.name }} (
										{{- country.currency.iso_code -}}
										)
									</button>
								{% endform %}
							</li>
						{% endfor %}
					</ul>
				</details>
			{% else %}
				<span>
					{{- localization.country.name }} (
					{{- localization.country.currency.iso_code -}}
					)
				</span>
			{% endif %}

			{% if section.settings.site_credits_url != blank %}
				<a href="{{ section.settings.site_credits_url }}">
					{{- section.settings.site_credits_label | escape -}}
				</a>
			{% else %}
				<span>{{ section.settings.site_credits_label | escape }}</span>
			{% endif %}
			<p>© {{ 'now' | date: '%Y' }} FOULPLAY. All rights reserved.</p>
		</div>
	</div>

	<div class="foulplay-footer__right">
		<nav class="foulplay-footer__links" aria-label="Footer">
			<div>
				<h2>{{ section.settings.customer_heading | escape }}</h2>
				<ul role="list">
					{% for link_key in (1..3) %}
						{% liquid
							case link_key
								when 1
									assign item_label = section.settings.contact_label
									assign item_url = section.settings.contact_url
								when 2
									assign item_label = section.settings.shipping_label
									assign item_url = section.settings.shipping_url
								when 3
									assign item_label = section.settings.returns_label
									assign item_url = section.settings.returns_url
							endcase
						%}
						<li>
							{% if item_url != blank -%}
								<a href="{{ item_url }}">
							{%- endif %}
							{{- item_label | escape -}}
							{% if item_url != blank %}</a>{% endif %}
						</li>
					{% endfor %}
				</ul>
			</div>
			<div>
				<h2>{{ section.settings.legal_heading | escape }}</h2>
				<ul role="list">
					{% if privacy_url != blank %}
						<li>
							<a href="{{ privacy_url }}">
								{{- section.settings.privacy_label | escape -}}
							</a>
						</li>
					{% endif %}
					{% if terms_url != blank %}
						<li>
							<a href="{{ terms_url }}">
								{{- section.settings.terms_label | escape -}}
							</a>
						</li>
					{% endif %}
					<li>
						{% if section.settings.cookies_url != blank %}
							<a href="{{ section.settings.cookies_url }}">
						{% endif %}
						{{- section.settings.cookies_label | escape -}}
						{% if section.settings.cookies_url != blank -%}
							</a>
						{%- endif %}
					</li>
				</ul>
			</div>
			<div>
				<h2>{{ section.settings.social_heading | escape }}</h2>
				<ul role="list">
					<li>
						{% if instagram_url != blank -%}
							<a href="{{ instagram_url }}">
						{%- endif %}
						{{- section.settings.instagram_label | escape -}}
						{% if instagram_url != blank %}</a>{% endif %}
					</li>
					<li>
						{% if tiktok_url != blank -%}
							<a href="{{ tiktok_url }}">
						{%- endif %}
						{{- section.settings.tiktok_label | escape -}}
						{% if tiktok_url != blank %}</a>{% endif %}
					</li>
				</ul>
			</div>
		</nav>

		<picture class="foulplay-footer__media" data-no-fade>
			{% if section.settings.image != blank %}
				{{
					section.settings.image
					| image_url: width: 1400
					| image_tag:
						widths: '453, 750, 1000, 1400',
						sizes: '(min-width: 1000px) 453px, calc(100vw - 32px)',
						loading: 'lazy',
						alt: section.settings.image_alt
				}}
			{% else %}
				<img
					src="{{ 'foulplay-footer.png' | asset_url }}"
					width="1080"
					height="1350"
					alt="{{ section.settings.image_alt | escape }}"
					loading="lazy"
				>
			{% endif %}
		</picture>
	</div>
</footer>

{% schema %}
	{
		"name": "Footer",
		"tag": "section",
		"class": "section section--custom-footer",
		"enabled_on": { "groups": ["footer"] },
		"settings": [
			{ "type": "header", "content": "Newsletter" },
			{
				"type": "text",
				"id": "newsletter_heading",
				"label": "Heading",
				"default": "Newsletter"
			},
			{
				"type": "textarea",
				"id": "newsletter_body",
				"label": "Body",
				"default": "Sign up to discover more about FOULPLAY and get 15% off your first order"
			},
			{
				"type": "text",
				"id": "email_label",
				"label": "Email label",
				"default": "Email Address*"
			},
			{
				"type": "text",
				"id": "phone_label",
				"label": "Phone label",
				"default": "Phone"
			},
			{
				"type": "text",
				"id": "consent_prefix",
				"label": "Consent prefix",
				"default": "By submitting, you agree to the"
			},
			{
				"type": "text",
				"id": "consent_joiner",
				"label": "Consent joiner",
				"default": "and"
			},
			{
				"type": "text",
				"id": "terms_label",
				"label": "Terms label",
				"default": "Terms & Conditions"
			},
			{ "type": "url", "id": "terms_url", "label": "Terms link" },
			{
				"type": "text",
				"id": "privacy_label",
				"label": "Privacy label",
				"default": "Privacy Policy"
			},
			{ "type": "url", "id": "privacy_url", "label": "Privacy link" },
			{
				"type": "text",
				"id": "submit_label",
				"label": "Submit label",
				"default": "Submit"
			},
			{
				"type": "text",
				"id": "success_message",
				"label": "Success message",
				"default": "Thank you for signing up."
			},
			{ "type": "header", "content": "Customer care" },
			{
				"type": "text",
				"id": "customer_heading",
				"label": "Heading",
				"default": "Customer Care"
			},
			{
				"type": "text",
				"id": "contact_label",
				"label": "Contact label",
				"default": "Contact Us"
			},
			{ "type": "url", "id": "contact_url", "label": "Contact link" },
			{
				"type": "text",
				"id": "shipping_label",
				"label": "Shipping label",
				"default": "Shipping & Delivery"
			},
			{ "type": "url", "id": "shipping_url", "label": "Shipping link" },
			{
				"type": "text",
				"id": "returns_label",
				"label": "Returns label",
				"default": "Returns & Exchanges"
			},
			{ "type": "url", "id": "returns_url", "label": "Returns link" },
			{ "type": "header", "content": "Legal and social" },
			{
				"type": "text",
				"id": "legal_heading",
				"label": "Legal heading",
				"default": "Legal"
			},
			{
				"type": "text",
				"id": "cookies_label",
				"label": "Cookies label",
				"default": "Cookies Policy"
			},
			{ "type": "url", "id": "cookies_url", "label": "Cookies link" },
			{
				"type": "text",
				"id": "social_heading",
				"label": "Social heading",
				"default": "Social"
			},
			{
				"type": "text",
				"id": "instagram_label",
				"label": "Instagram label",
				"default": "Instagram"
			},
			{ "type": "url", "id": "instagram_url", "label": "Instagram link" },
			{
				"type": "text",
				"id": "tiktok_label",
				"label": "TikTok label",
				"default": "TikTok"
			},
			{ "type": "url", "id": "tiktok_url", "label": "TikTok link" },
			{ "type": "header", "content": "Footnotes" },
			{
				"type": "textarea",
				"id": "disclaimer",
				"label": "Disclaimer",
				"default": "All of our products are sold as food supplements and not intended to diagnose, cure, prevent or treat disease. Always consult your health professional before taking any food supplements."
			},
			{
				"type": "text",
				"id": "site_credits_label",
				"label": "Site credits label",
				"default": "Site Credits"
			},
			{
				"type": "url",
				"id": "site_credits_url",
				"label": "Site credits link"
			},
			{ "type": "header", "content": "Artwork" },
			{ "type": "image_picker", "id": "image", "label": "Image" },
			{ "type": "text", "id": "image_alt", "label": "Image alt text" }
		],
		"presets": [{ "name": "Footer" }]
	}
{% endschema %}

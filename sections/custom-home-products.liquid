{% comment %}
	=== FUNCTIONALITY ===

	- Shows the subscription message and the product cards from the homepage design.
	- Filters the product cards by their merchant-defined categories.
	- Uses reusable product theme blocks for each card.


	Section Author: rishi@subject-matter.studio
{% endcomment %}

{% # MARK:- Homepage product showcase from Figma node 3223:34281 %}
<foulplay-product-showcase
	class="foulplay-product-module"
	data-node-id="3223:34281"
>
	<div class="foulplay-product-module__intro">
		<div class="foulplay-product-module__intro-copy">
			<h2>{{ section.settings.heading | escape }}</h2>
			{% if section.settings.body != blank %}
				<div>{{ section.settings.body }}</div>
			{% endif %}
		</div>
		{% render 'custom-foulplay-button',
			label: section.settings.button_label,
			url: section.settings.button_link,
			style: 'secondary'
		%}
	</div>

	<div
		class="foulplay-product-module__filters"
		aria-label="{{ section.settings.filter_label | escape }}"
	>
		<button
			type="button"
			aria-pressed="true"
			data-product-filter="featured"
		>
			{{ section.settings.featured_label | escape }}
			<span class="foulplay-product-module__count">0</span>
		</button>
		<button
			type="button"
			aria-pressed="false"
			data-product-filter="creatine"
		>
			{{ section.settings.creatine_label | escape }}
			<span class="foulplay-product-module__count">0</span>
		</button>
		<button
			type="button"
			aria-pressed="false"
			data-product-filter="hydration"
		>
			{{ section.settings.hydration_label | escape }}
			<span class="foulplay-product-module__count">0</span>
		</button>
		<button
			type="button"
			aria-pressed="false"
			data-product-filter="complements"
		>
			{{ section.settings.complements_label | escape }}
			<span class="foulplay-product-module__count">0</span>
		</button>
	</div>

	<div class="foulplay-product-module__items" data-product-items>
		{% content_for 'blocks' %}
	</div>
	<p
		class="visually-hidden"
		role="status"
		aria-live="polite"
		data-product-status
	></p>
</foulplay-product-showcase>

{% schema %}
	{
		"name": "Subscription products",
		"tag": "section",
		"class": "section section--home-products",
		"disabled_on": { "groups": ["header", "footer"] },
		"blocks": [{ "type": "foulplay-product" }],
		"max_blocks": 12,
		"settings": [
			{
				"type": "text",
				"id": "heading",
				"label": "Heading",
				"default": "Save with Subscriptions"
			},
			{ "type": "richtext", "id": "body", "label": "Body" },
			{
				"type": "text",
				"id": "button_label",
				"label": "Button label",
				"default": "Shop All"
			},
			{ "type": "url", "id": "button_link", "label": "Button link" },
			{
				"type": "text",
				"id": "filter_label",
				"label": "Filter label",
				"default": "Filter products"
			},
			{
				"type": "text",
				"id": "featured_label",
				"label": "Featured label",
				"default": "Featured"
			},
			{
				"type": "text",
				"id": "creatine_label",
				"label": "Creatine label",
				"default": "Creatine"
			},
			{
				"type": "text",
				"id": "hydration_label",
				"label": "Hydration label",
				"default": "Hydration"
			},
			{
				"type": "text",
				"id": "complements_label",
				"label": "Complements label",
				"default": "Complements"
			}
		],
		"presets": [{ "name": "Subscription products" }]
	}
{% endschema %}

{% comment %}
	=== FUNCTIONALITY ===

	- Renders one selectable bundle tab and its linked purchase panel.
	- Uses a Shopify product for price, destination, availability, and cart submission.
	- Records component choices as line item properties.


	Section Author: rishi@subject-matter.studio
{% endcomment %}

{% liquid
	assign bundle_product = block.settings.product
	assign bundle_variant = bundle_product.selected_or_first_available_variant
	assign bundle_title = block.settings.heading
	if bundle_title == blank and bundle_product != blank
		assign bundle_title = bundle_product.title
	endif
	assign bundle_url = block.settings.link
	if bundle_url == blank and bundle_product != blank
		assign bundle_url = bundle_product.url
	endif
	assign bundle_url = bundle_url | default: routes.all_products_collection_url
	assign sale_price = block.settings.sale_price
	if sale_price == blank and bundle_product != blank
		assign sale_price = bundle_product.price | money
	endif
	assign main_image = block.settings.image
	if main_image == blank and block.settings.artwork_style != 'complete' and bundle_product != blank
		assign main_image = bundle_product.featured_image
	endif
	assign panel_id = 'bundle-panel-' | append: block.id
	assign tab_id = 'bundle-tab-' | append: block.id
	assign bundle_disabled = false
	if bundle_variant != blank and bundle_variant.available == false
		assign bundle_disabled = true
	endif
%}

{% # MARK:- Bundle selector block from Figma node 1287:133759 %}
<button
	class="foulplay-bundle-tab foulplay-bundle-tab--{{ block.settings.artwork_style }}"
	type="button"
	id="{{ tab_id }}"
	role="tab"
	aria-controls="{{ panel_id }}"
	aria-selected="false"
	tabindex="-1"
	data-bundle-tab="{{ block.id }}"
>
	<span class="foulplay-bundle-tab__artwork" aria-hidden="true">
		{% if block.settings.artwork_style == 'complete'
			or block.settings.artwork_style == 'creatine'
		%}
			<span class="foulplay-bundle-thumb foulplay-bundle-thumb--hi">
				<img
					src="{{ 'foulplay-header-hi-creatine.png' | asset_url }}"
					width="1169"
					height="1628"
					alt=""
					loading="lazy"
				>
			</span>
			<span class="foulplay-bundle-thumb foulplay-bundle-thumb--purest">
				<img
					src="{{ 'foulplay-header-purest-creatine.png' | asset_url }}"
					width="1169"
					height="1628"
					alt=""
					loading="lazy"
				>
			</span>
		{% endif %}
		{% if block.settings.artwork_style == 'complete'
			or block.settings.artwork_style == 'hydration'
		%}
			<span class="foulplay-bundle-thumb foulplay-bundle-thumb--electrolytes">
				<img
					src="{{ 'foulplay-product-electrolytes.png' | asset_url }}"
					width="3277"
					height="4096"
					alt=""
					loading="lazy"
				>
			</span>
		{% endif %}
	</span>
	<span class="foulplay-bundle-tab__copy">
		<span>{{ bundle_title | escape }}</span>
		<span>{{ sale_price | escape }}</span>
		<span class="foulplay-bundle-tab__rating">
			<img
				src="{{ 'foulplay-icon-star.svg' | asset_url }}"
				width="16"
				height="16"
				alt=""
			>
			{{ block.settings.rating | escape }}
		</span>
	</span>
</button>

<article
	class="foulplay-bundle-panel"
	id="{{ panel_id }}"
	role="tabpanel"
	aria-labelledby="{{ tab_id }}"
	data-bundle-panel="{{ block.id }}"
	data-bundle-title="{{ bundle_title | escape }}"
	hidden
	{{ block.shopify_attributes }}
>
	<div class="foulplay-bundle-panel__left-track">
		<div class="foulplay-bundle-panel__copy">
			<div class="foulplay-bundle-panel__summary">
				<div>
					<h3>
						<a href="{{ bundle_url }}">
							{{- bundle_title | escape -}}
						</a>
					</h3>
					<p class="foulplay-bundle-panel__price">
						{% if block.settings.regular_price != blank %}
							<span class="visually-hidden">Regular price</span>
							<s>{{ block.settings.regular_price | escape }}</s>
						{% endif %}
						<span class="visually-hidden">Sale price</span>
						<span>{{ sale_price | escape }}</span>
					</p>
				</div>
				<div>
					<p class="foulplay-bundle-panel__review">
						<img
							src="{{ 'foulplay-icon-star.svg' | asset_url }}"
							width="16"
							height="16"
							alt=""
						>
						<span>{{ block.settings.rating | escape }}</span>
						<span>{{ block.settings.review_count | escape }}</span>
					</p>
					{% if block.settings.description != blank %}
						<div class="foulplay-bundle-panel__description">
							{{ block.settings.description }}
						</div>
					{% endif %}
				</div>
			</div>

			{% if bundle_variant != blank %}
				{% form 'product',
					bundle_product,
					class: 'foulplay-bundle-panel__form'
				%}
					<input
						type="hidden"
						name="id"
						value="{{ bundle_variant.id }}"
					>
					<input type="hidden" name="quantity" value="1">
					<div class="foulplay-bundle-panel__options">
						{% for option_index in (1..3) %}
							{% liquid
								case option_index
									when 1
										assign option_label = block.settings.option_1_label
										assign option_values = block.settings.option_1_values
									when 2
										assign option_label = block.settings.option_2_label
										assign option_values = block.settings.option_2_values
									else
										assign option_label = block.settings.option_3_label
										assign option_values = block.settings.option_3_values
								endcase
								assign option_lines = option_values | newline_to_br | split: '<br />'
								assign first_parts = option_lines.first | strip | split: '|'
							%}
							{% if option_label != blank
								and option_values != blank
							%}
								<label class="foulplay-bundle-option">
									<span class="foulplay-bundle-option__label">
										{{- option_label | escape -}}
									</span>
									<span class="foulplay-bundle-option__control">
										<span data-option-flavour>
											{{-
												first_parts.first
												| strip
												| escape
											-}}
										</span>
										<span
											class="foulplay-bundle-option__pill"
											data-option-size
										>
											{{-
												first_parts.last
												| strip
												| escape
											-}}
										</span>
										<span
											class="foulplay-bundle-option__chevron"
											aria-hidden="true"
										></span>
										<select
											name="properties[{{ option_label | escape }}]"
											data-bundle-option
										>
											{% for option_line in option_lines %}
												{% liquid
													assign option_parts = option_line | strip | split: '|'
													assign option_flavour = option_parts.first | strip
													assign option_size = option_parts.last | strip
												%}
												<option
													value="{{ option_flavour | escape }} — {{ option_size | escape }}"
													data-flavour="{{ option_flavour | escape }}"
													data-size="{{ option_size | escape }}"
												>
													{{-
														option_flavour
														| escape
													}}
													—
													{{ option_size | escape -}}
												</option>
											{% endfor %}
										</select>
									</span>
								</label>
							{% endif %}
						{% endfor %}
					</div>
					{% render 'custom-foulplay-button',
						label: block.settings.button_label,
						style: 'primary',
						type: 'submit',
						disabled: bundle_disabled
					%}
				{% endform %}
			{% else %}
				{% render 'custom-foulplay-button',
					label: block.settings.button_label,
					url: bundle_url,
					style: 'primary'
				%}
			{% endif %}
		</div>
	</div>

	<a
		class="foulplay-bundle-panel__media"
		href="{{ bundle_url }}"
		aria-label="{{ bundle_title | escape }}"
	>
		{% if main_image != blank %}
			{{
				main_image
				| image_url: width: 2200
				| image_tag:
					widths: '750, 1100, 1500, 1846, 2200',
					sizes: '(min-width: 1000px) 64vw, 100vw',
					loading: 'lazy',
					alt: ''
			}}
		{% else %}
			<img
				src="{{ 'foulplay-bundle-complete.png' | asset_url }}"
				width="410"
				height="512"
				alt=""
				loading="lazy"
			>
		{% endif %}
	</a>
</article>

{% schema %}
	{
		"name": "Bundle",
		"settings": [
			{ "type": "product", "id": "product", "label": "Product" },
			{
				"type": "select",
				"id": "artwork_style",
				"label": "Tab artwork",
				"options": [
					{ "value": "complete", "label": "Complete" },
					{ "value": "creatine", "label": "Creatine" },
					{ "value": "hydration", "label": "Hydration" }
				],
				"default": "complete"
			},
			{ "type": "image_picker", "id": "image", "label": "Main image" },
			{ "type": "text", "id": "heading", "label": "Heading" },
			{ "type": "text", "id": "regular_price", "label": "Regular price" },
			{ "type": "text", "id": "sale_price", "label": "Sale price" },
			{
				"type": "text",
				"id": "rating",
				"label": "Rating",
				"default": "4.8"
			},
			{ "type": "text", "id": "review_count", "label": "Review count" },
			{ "type": "richtext", "id": "description", "label": "Description" },
			{ "type": "url", "id": "link", "label": "Link override" },
			{
				"type": "text",
				"id": "option_1_label",
				"label": "Option 1 label"
			},
			{
				"type": "textarea",
				"id": "option_1_values",
				"label": "Option 1 values"
			},
			{
				"type": "text",
				"id": "option_2_label",
				"label": "Option 2 label"
			},
			{
				"type": "textarea",
				"id": "option_2_values",
				"label": "Option 2 values"
			},
			{
				"type": "text",
				"id": "option_3_label",
				"label": "Option 3 label"
			},
			{
				"type": "textarea",
				"id": "option_3_values",
				"label": "Option 3 values"
			},
			{
				"type": "text",
				"id": "button_label",
				"label": "Button label",
				"default": "Add to Cart"
			}
		],
		"presets": [{ "name": "Bundle" }]
	}
{% endschema %}
